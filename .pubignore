# Exclude screenshot assets except the main search preview.
assets/images/*
!assets/images/screen_2.webp

# Exclude maintainer-only tests.
/test/
/integration_test/
/example/test/
/example/integration_test/

# Exclude the example's platform projects.
/example/android/
/example/ios/
/example/web/

# Exclude local environment variables, signing keys, and generated files.
build/
coverage/
**/doc/api/
**/generated_plugin_registrant.dart
.dart_tool/
.vscode/
.idea/
.env
.env.*
.metadata
.flutter-plugins-dependencies
/devtools_options.yaml
*.class
*.iml
*.ipr
*.iws
*.jks
*.keystore
*.log
*.pyc
*.swp
env.g.dart

# Publish the example's env template and gitignore.
!example/.env.example
!example/.gitignore
!example/pubspec.lock

# Exclude AI agent context.
.agents/
.claude/
.cursor/
.github/
AGENTS.md
build-agent-context.sh
