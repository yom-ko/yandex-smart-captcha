/example/android/
/example/ios/
/example/linux/
/example/macos/
/example/web/
/example/windows/

# Exclude local environment variables, signing keys, and generated files.
build/
coverage/
migrate_working_dir/
pubspec_overrides.yaml
local.properties
key.properties
app.*.symbols
app.*.map.json
**/doc/api/
**/generated_plugin_registrant.dart
.dart_tool/
.vscode/
