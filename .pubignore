# Exclude native platform folders and local build artifacts in example/
example/ios/
example/android/
example/web/
example/macos/
example/windows/
example/linux/
example/build/
example/integration_test/
example/.dart_tool/
example/.vscode/
example/.idea/
example/analysis_options.yaml
example/devtools_options.yaml

# Exclude screenshot assets except the main search preview
assets/images/*
!assets/images/screen_2.webp

# Exclude local environment variables, IDE settings, and build files
build/
integration_test/
.dart_tool/
.vscode/
.idea/
.env
.env.example
.metadata
.flutter-plugins-dependencies
devtools_options.yaml
