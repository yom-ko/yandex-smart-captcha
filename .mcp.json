{
	"mcpServers": {
		"patrol": {
			"args": [
				"pub",
				"run",
				"--directory=example",
				"patrol_mcp"
			],
			"command": "dart",
			"env": {
				"PATROL_FLAGS": "--dart-define-from-file=.env",
				"PROJECT_ROOT": "example",
				"SHOW_TERMINAL": "false"
			},
			"tools": [
				"*"
			],
			"type": "stdio"
		}
	}
}
