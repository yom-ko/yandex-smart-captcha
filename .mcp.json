{
	"mcpServers": {
		"patrol": {
			"args": [
				"--packages=example/.dart_tool/package_config.json",
				"tool/patrol_mcp.dart"
			],
			"command": "dart",
			"env": {
				"PATROL_FLAGS": "--dart-define-from-file=.env",
				"SHOW_TERMINAL": "false"
			},
			"tools": [
				"*"
			],
			"type": "stdio"
		},
		"serena": {
			"args": [
				"--from",
				"git+https://github.com/oraios/serena",
				"serena",
				"start-mcp-server",
				"--context=vscode",
				"--project-from-cwd"
			],
			"command": "uvx",
			"tools": [
				"*"
			],
			"type": "stdio"
		}
	}
}
