{
	"mcpServers": {
		"patrol": {
			"args": [
				"pub",
				"run",
				"--directory=example",
				"patrol_mcp"
			],
			"command": "flutter",
			"env": {
				"PATROL_FLAGS": "--dart-define-from-file=.env",
				"PROJECT_ROOT": "example",
				"SHOW_TERMINAL": "false"
			},
			"tools": [
				"*"
			],
			"type": "stdio"
		},
		"serena": {
			"args": [
				"--from",
				"git+https://github.com/oraios/serena",
				"serena",
				"start-mcp-server",
				"--project-from-cwd"
			],
			"command": "uvx",
			"tools": [
				"*"
			],
			"type": "stdio"
		}
	}
}
